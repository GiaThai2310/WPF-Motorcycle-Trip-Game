<Window x:Class="WPF_Motorcycle_Trip_Game.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Motorcycle Road Trip"
        Width="1000"
        Height="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnWindowKeyDown"
        Closed="OnWindowClosed">
    <Canvas x:Name="GameCanvas" Background="#87CEEB">
        <Rectangle Canvas.Top="330"
                   Width="1000"
                   Height="120"
                   Fill="#3F3F46" />

        <Image x:Name="BikeImage"
               Width="120"
               Height="80"
               Stretch="Uniform" />

        <TextBlock x:Name="ScoreText"
                   Canvas.Left="20"
                   Canvas.Top="20"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="White"
                   Text="Score: 0" />

        <TextBlock x:Name="MessageText"
                   Canvas.Left="330"
                   Canvas.Top="120"
                   Width="340"
                   TextAlignment="Center"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White" />

        <Button x:Name="RestartButton"
                Canvas.Left="440"
                Canvas.Top="185"
                Width="120"
                Height="40"
                Content="Restart"
                Click="OnRestartClick"
                Visibility="Collapsed" />
    </Canvas>
</Window>
