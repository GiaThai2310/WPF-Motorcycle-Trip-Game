<!-- Main WPF game window view defining canvas layers, asset images, score display, and message overlay -->
<Window x:Class="WPF_Motorcycle_Trip_Game.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:WPF_Motorcycle_Trip_Game.Core"
        Title="Motorcycle Road Trip"
        Width="{x:Static core:GameConstants.WindowWidth}"
        Height="{x:Static core:GameConstants.WindowHeight}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnWindowKeyDown"
        Closed="OnWindowClosed">
    <Canvas x:Name="GameCanvas" Background="#87CEEB">
        <!-- Sky background layer -->
        <Image x:Name="BackgroundImage" 
               Source="/Assets/background.png"
               Width="{x:Static core:GameConstants.WindowWidth}"
               Height="{x:Static core:GameConstants.GroundY}"
               Stretch="Fill" />

        <!-- Dual scrolling road tile layer 1 -->
        <Image x:Name="RoadImage1"
               Source="/Assets/road.png"
               Canvas.Top="{x:Static core:GameConstants.GroundY}"
               Canvas.Left="0"
               Width="{x:Static core:GameConstants.WindowWidth}"
               Height="{x:Static core:GameConstants.RoadHeight}"
               Stretch="Fill" />

        <!-- Dual scrolling road tile layer 2 -->
        <Image x:Name="RoadImage2"
               Source="/Assets/road.png"
               Canvas.Top="{x:Static core:GameConstants.GroundY}"
               Canvas.Left="{x:Static core:GameConstants.WindowWidth}"
               Width="{x:Static core:GameConstants.WindowWidth}"
               Height="{x:Static core:GameConstants.RoadHeight}"
               Stretch="Fill" />

        <!-- Player motorcycle visual -->
        <Image x:Name="BikeImage"
               Source="/Assets/motorcycle.png"
               Width="{x:Static core:GameConstants.BikeWidth}"
               Height="{x:Static core:GameConstants.BikeHeight}"
               Stretch="Uniform" />

        <!-- Score text overlay -->
        <TextBlock x:Name="ScoreText"
                   Style="{StaticResource ScoreTextStyle}"
                   Canvas.Left="20"
                   Canvas.Top="20"
                   Text="Score: 0" />

        <!-- Game state message overlay (centered full width) -->
        <TextBlock x:Name="MessageText"
                   Style="{StaticResource MessageTextStyle}"
                   Canvas.Left="0"
                   Canvas.Top="120"
                   Width="{x:Static core:GameConstants.WindowWidth}" />

        <!-- Restart button overlay -->
        <Button x:Name="RestartButton"
                Style="{StaticResource RestartButtonStyle}"
                Canvas.Left="440"
                Canvas.Top="185"
                Width="120"
                Height="40"
                Content="Restart"
                Click="OnRestartClick"
                Visibility="Collapsed" />
    </Canvas>
</Window>
